{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://tenant-system-prototype.onrender.com/api/:path*"
    },
    {
      "source": "/sanctum/csrf-cookie",
      "destination": "https://tenant-system-prototype.onrender.com/sanctum/csrf-cookie"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
