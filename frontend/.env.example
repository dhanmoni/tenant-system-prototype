# Backend API origin. Also the origin signed document URLs are minted against.
VITE_API_URL=http://localhost:8000

# Shared key for the locally installed DSC Agent (the service that owns the USB token driver and
# signs hearing notices on the officer's own machine).
#
# This is not a server credential. It authenticates this page to a service listening on
# 127.0.0.1 on the same machine as the browser, and anything in a frontend bundle is readable by
# whoever loads it. It lives here so a deployment can rotate it without a code change. Copy the
# value from the DSC Agent installation.
VITE_DSC_API_KEY=

# Sequential (first-in-first-out) processing guard in the admin inboxes.
VITE_ENABLE_FIFO=false
